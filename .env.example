# ---------------------------------------------------------------------------
# Komtru Operations — environment template.
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# ---------------------------------------------------------------------------

# Backend origin + version prefix. All browser traffic goes to same-origin
# `/api/...` and is rewritten here by next.config.ts.
NEXT_PUBLIC_BASE_URL=http://localhost:7821/v1

# Public origin of this app. Drives `metadataBase`.
NEXT_PUBLIC_APP_URL=http://localhost:7820
